{
  "manifest_version": 3,
  "name": "WL AD SPY LAB",
  "short_name": "WL AD SPY LAB",
  "version": "0.3.0",
  "description": "Central de pesquisa, organização, inteligência e transcrição automática de anúncios.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage",
    "contextMenus"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Abrir WL AD SPY LAB",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
