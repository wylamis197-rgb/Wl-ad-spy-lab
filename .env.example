# Configure estas variáveis no projeto da Vercel (não na extensão Chrome).
# Token aleatório longo para proteger seu endpoint pessoal.
AD_SPY_ACCESS_TOKEN=gere-um-token-longo-e-unico

# ID de modelo disponível no Vercel AI Gateway, no formato provedor/modelo.
# Consulte o catálogo atual antes de escolher.
AI_MODEL=google/modelo-disponivel-no-gateway

# Em deploy Vercel, prefira a autenticação integrada/OIDC do AI Gateway.
# Fora da Vercel, use AI_GATEWAY_API_KEY quando exigido pela sua conta.
# AI_GATEWAY_API_KEY=
